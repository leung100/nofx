# NOFX Environment Variables Template
# Copy this file to .env and modify the values as needed

# Ports Configuration
# Backend API server port (internal: 8080, external: configurable)
NOFX_BACKEND_PORT=8080

# Frontend web interface port (Nginx listens on port 80 internally)
NOFX_FRONTEND_PORT=3000

# Timezone Setting
# System timezone for container time synchronization
NOFX_TIMEZONE=Asia/Shanghai


# News Monitoring APIs (Optional)
CRYPTOPANIC_API_KEY=
NITTER_INSTANCE=nitter.net

# AI-Powered News Filtering (Optional)
# Enable AI to score and filter news for relevance before sending to trading agent
# This reduces noise and improves signal quality using DeepSeek or OpenAI
# Default: false (uses keyword filtering only)
ENABLE_AI_NEWS_FILTER=false

# DeepSeek API Key (Recommended for AI filtering - very cheap)
# Get free key at: https://platform.deepseek.com/
# Cost: ~$0.00013 per cycle (~$1.86/month for 24/7 operation)
DEEPSEEK_API_KEY=

# Alternative: OpenAI API Key (more expensive but available)
# OPENAI_API_KEY=

# AI Filter Configuration (Advanced)
# Only change these if you know what you're doing
AI_FILTER_BASE_URL=https://api.deepseek.com/v1
AI_FILTER_MODEL=deepseek-chat
